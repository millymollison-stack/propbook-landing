/* Override react-day-picker internal padding and margins */

/* Day numbers: must be visible on white modal background */
.rdp-day {
  color: #111 !important;
}

/* Selected day: white text on brand color */
.rdp-day_selected,
.rdp-day_selected:focus-visible,
.rdp-day_selected:hover {
  color: #fff !important;
}

/* Range middle/start/end days: dark blue text */
.rdp-day_range_middle,
.rdp-day_range_start,
.rdp-day_range_end {
  color: #1E40AF !important;
}

/* Today: darker text to distinguish */
.rdp-day_today:not(.rdp-day_outside):not(.rdp-day_selected) {
  color: #111 !important;
  font-weight: 700 !important;
}

/* Disabled/past days: lighter text */
.rdp-button[disabled]:not(.rdp-day_selected) {
  opacity: 0.35 !important;
}

.rdp,
.rdp-root,
.rdp-months,
.rdp-month,
.rdp-caption,
.rdp-table {
  padding-right: 0 !important;
  margin-right: 0 !important;
  max-width: 100% !important;
  outline: none !important;
}

/* Remove any dotted outlines */
.rdp-button {
  outline: none !important;
}

/* Ensure no overflow */
.rdp-root {
  overflow: hidden !important;
}

/* Weekday headers - force 3 letters */
.rdp-head_cell::after {
  content: '';
  display: inline-block;
  width: 0;
}

/* Style weekday cells to fit 3 letters */
.rdp-head_cell {
  font-size: 14px !important;
  letter-spacing: 0 !important;
}

/* Align navigation arrows to sit next to month text */
.rdp-caption {
  display: flex !important;
  justify-content: flex-start !important;
  align-items: center !important;
  gap: 10px !important;
}

.rdp-nav {
  display: flex !important;
  gap: 8px;
}

/* ────────────────────────────────────────────────────────────────
   Fix weekday-header / date-number grid misalignment at full width.
   Without table-layout:fixed, the browser sizes <th> (header) and
   <td> (day) columns independently once the day squares grow past
   their percentage width (aspect-ratio boxes), so the two rows
   drift out of alignment on wide screens.
   ──────────────────────────────────────────────────────────────── */
.rdp-table,
.booking-calendar table {
  table-layout: fixed !important;
  width: 100% !important;
  border-collapse: collapse !important;
}

.rdp-head_cell,
.rdp-cell {
  width: 14.2857% !important;
  max-width: 14.2857% !important;
  box-sizing: border-box !important;
  padding: 0 !important;
}

.rdp-day {
  width: 100% !important;
  box-sizing: border-box !important;
}


